# Long random string. When set, the server only answers at /mcp/<CONNECTOR_SECRET>
# (or /mcp with header "Authorization: Bearer <CONNECTOR_SECRET>").
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave empty ONLY for local testing - with no secret anyone who has the URL can use your server.
CONNECTOR_SECRET=

# Port to listen on (most hosts set this for you).
PORT=8787

# Optional tuning
CACHE_TTL_SECONDS=600
FETCH_TIMEOUT_MS=10000
MAX_DOWNLOAD_BYTES=3000000
RATE_LIMIT_PER_MINUTE=60
