{
 "format": "agent-city-cad/1",
 "name": "Louvre-Slide Door",
 "description": "A step-free sliding door whose four wooden slats turn like blinds for airflow and privacy, then the whole frame slides away into a parking bay.",
 "units": "mm",
 "how_it_works": [
  "Closed, four slats sit edge to edge with brush seals, forming a solid wall like a normal door.",
  "Turning the single dial a quarter turn swivels all four slats together, so air and light pass between them.",
  "Because the slats turn on their own axes, the door needs no swing space, unlike a hinged door that sweeps a big arc.",
  "To pass through, grip the handle and slide the frame along the overhead track, parking it in front of the wall beside the opening.",
  "The frame hangs from the top, so the floor stays flat with no step to trip over."
 ],
 "assumptions": [
  "Opening is 900 x 2100 mm; slats are 26 mm solid timber.",
  "Dial-to-slat link is simplified to a direct coupling; a real one would use a cord or gear train.",
  "No lock is modelled."
 ],
